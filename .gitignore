# ─────────────────────────────────────────────────────────────
# 개인정보 — 절대 커밋하지 말 것
# ─────────────────────────────────────────────────────────────
# 설계사 실명·사용인코드·개인 실적이 들어 있다.
# 원본 파일만 있으면 ./refresh.sh 로 언제든 재생성되므로 저장소에 둘 이유가 없다.
etl/cache/
# 하위 폴더까지 전부. 예전엔 dashboard/data/*.json 이었는데
# data/dept/ · data/center/ 가 생기면서 하위가 안 걸려 유출될 뻔했다.
dashboard/data/

# 지점별 월 목표 (사내 대외비). 구조는 targets.example.json 참고.
etl/targets.json

# 원본 실적 파일이 혹시 저장소 안으로 들어오는 사고 방지
*.xlsb
*.xlsx
*.xls

# ─────────────────────────────────────────────────────────────
# 빌드 산출물 / 의존성
# ─────────────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ─────────────────────────────────────────────────────────────
# 로컬 환경
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
__pycache__/
*.py[cod]
.venv/
venv/
