# 이 파일을 .env.local 로 복사해서 값을 채운다.
# .env.local 은 .gitignore 에 걸려 있으므로 저장소에 올라가지 않는다.

# 대시보드 접속 비밀번호. 이 값이 없으면 로그인 자체가 불가능하다.
APP_PASSWORD=

# 세션 쿠키 서명 키. 비워 두면 APP_PASSWORD 에서 유도하지만,
# 비밀번호를 바꿔도 기존 세션이 유지되게 하려면 직접 넣는 편이 낫다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# HTTPS 로 서비스할 때만 1 로 켠다.
# 로컬 http 접속에서 켜면 쿠키가 저장되지 않아 로그인이 무한 반복된다.
SECURE_COOKIE=0
